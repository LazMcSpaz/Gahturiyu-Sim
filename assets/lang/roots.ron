// The First Speech root list: the shared stock every tongue's words are made
// from. Read by src/names/mod.rs.
//
//   id      the English key other data refers to
//   first   the root in First Speech form (sounds: see sounds.ron)
//   gloss   what it means
//   field   the area of meaning it belongs to
//   canon   the existing Roduro (Gogìḍu) word this root was worked backwards
//           from. The Roduro sound rules must turn `first` back into exactly
//           this (a test checks). Roots without it are new, and stand only
//           until checked against the full Gogìḍu dictionary.
[

    // ---- Land and sea ------------------------------------------------
    (id: "earth", first: "rodu", gloss: "earth, dirt, the ground", field: Land, canon: Some("rodu")),
    (id: "soil", first: "dodì", gloss: "soil", field: Land, canon: Some("dodì")),
    (id: "island", first: "wahì", gloss: "island", field: Sea, canon: Some("gahì")),
    (id: "waterway", first: "pora", gloss: "waterway, river, flowing water", field: Sea, canon: Some("hora")),
    (id: "rock", first: "ḍoka", gloss: "rock, bedrock", field: Land),
    (id: "stone", first: "doqo", gloss: "a stone", field: Land),
    (id: "hill", first: "puli", gloss: "hill", field: Land),
    (id: "slope", first: "lesa", gloss: "slope, hillside", field: Land),
    (id: "cliff", first: "qara", gloss: "cliff", field: Land),
    (id: "ledge", first: "tiʻe", gloss: "ledge, shelf of rock", field: Land),
    (id: "crag", first: "karaki", gloss: "crag, jagged rock", field: Land),
    (id: "mountain", first: "ṭomu", gloss: "mountain", field: Land),
    (id: "valley", first: "lupe", gloss: "valley", field: Land),
    (id: "gorge", first: "giqu", gloss: "gorge, ravine", field: Land),
    (id: "cave", first: "kupo", gloss: "cave", field: Land),
    (id: "shore", first: "nali", gloss: "shore, coast", field: Sea),
    (id: "sand", first: "sene", gloss: "sand, beach", field: Sea),
    (id: "bay", first: "wapa", gloss: "bay", field: Sea),
    (id: "cove", first: "meʻo", gloss: "cove, small inlet", field: Sea),
    (id: "reef", first: "raku", gloss: "reef", field: Sea),
    (id: "stack", first: "tuṭu", gloss: "sea stack, standing rock", field: Sea),
    (id: "sea", first: "moʻa", gloss: "the sea", field: Sea),
    (id: "deep", first: "ḍupu", gloss: "deep, the deep", field: Sea),
    (id: "stream", first: "sili", gloss: "stream, brook", field: Land),
    (id: "spring", first: "nuʻi", gloss: "spring, well", field: Land),
    (id: "marsh", first: "gomu", gloss: "marsh, bog", field: Land),
    (id: "field", first: "tale", gloss: "field, open ground", field: Land),
    (id: "forest", first: "woṭa", gloss: "a wood, forest", field: Land),
    (id: "heath", first: "ḍire", gloss: "heath, moor", field: Land),
    (id: "road", first: "sadu", gloss: "road, way", field: Land),
    (id: "pass", first: "qeno", gloss: "pass, gap between hills", field: Land),
    (id: "plateau", first: "tapu", gloss: "plateau, tableland", field: Land),
    (id: "plain", first: "lamaʻa", gloss: "plain, flat country", field: Land),
    (id: "pool", first: "mola", gloss: "pool, lake", field: Land),
    (id: "mouth", first: "awo", gloss: "mouth, opening, river mouth", field: Sea),
    (id: "headland", first: "ḍuko", gloss: "headland, point", field: Sea),
    (id: "peak", first: "tiki", gloss: "peak, summit", field: Land),
    (id: "ridge", first: "guri", gloss: "ridge, spine", field: Land),
    (id: "hollow", first: "pomo", gloss: "hollow, dip", field: Land),
    (id: "mud", first: "luta", gloss: "mud", field: Land),
    (id: "tide", first: "deʻi", gloss: "tide", field: Sea),
    (id: "wave", first: "wala", gloss: "wave", field: Sea),
    (id: "foam", first: "puʻa", gloss: "foam, spray", field: Sea),
    (id: "harbour", first: "temo", gloss: "harbour, haven", field: Sea),
    (id: "brow", first: "ṭipa", gloss: "brow, overhang, edge", field: Land),
    (id: "pit", first: "qopu", gloss: "pit, quarry", field: Land),
    (id: "bank", first: "tepa", gloss: "bank, terrace", field: Land),
    (id: "ford", first: "tawe", gloss: "ford, crossing", field: Land),

    // ---- Weather and sky ---------------------------------------------
    (id: "sky", first: "laʻi", gloss: "sky", field: Sky),
