// The names of things: jobs, crafts, materials, items, buildings, creatures
// and weather. Read by src/names/things.rs; the table it makes is
// docs/things.md (`cargo run --release --bin lang -- things`).
//
//   english   the name the game shows. These are the game's own names
//             (src/sim/jobs.rs, items.rs, materials.rs, base.rs, crafting.rs,
//             animals/species.rs, weather/local.rs) and are never changed
//             here. tests/names.rs checks every one of them has an entry.
//   group     where it goes in the table.
//   belongs   Roduro, Qotiro, Horaro or Tadoro when the thing is one people's
//             own: its native name is in their tongue and everyone uses it.
//             Left out when every people has the thing: then each tongue
//             has its own word, built by the same recipe.
//   made      the recipe for the native name, from root ids (roots.ron):
//               stone             a root
//               black+water       the first describes the second
//               forge:agent       an ending: agent (one who), place, small,
//                                 great, kind, most
//               ring/swift        two words: "ring of swiftness"
//               =Bronze           another thing's native name
//               *turiyu           a First Speech form, worn down by each tongue
//               @qotihiqi         a god, by id (sacred.ron)
//   also      other English names the code uses for the same thing.
//
// The native names are never typed in. To change one, change its recipe.
//
// Who owns what follows the making traditions in src/sim/materials.rs
// (grown = Roduro, fire-made = Qotiro, sea and shore = Horaro, written and
// carried = Ṭaḍoro), architecture.md, and where a creature lives.
[
    // ==== Jobs (src/sim/jobs.rs, baselife.rs) ==================================
    (english: "No trade", group: Job, made: "empty+hand"),
    (english: "Farmer", group: Job, made: "plant:agent"),
    (english: "Fisher and diver", group: Job, belongs: Some(Horaro), made: "dive:agent"),
    (english: "Forager and hunter", group: Job, made: "hunt:agent"),
    (english: "Woodcutter and quarrier", group: Job, made: "cut:agent"),
    (english: "Stone Tender", group: Job, belongs: Some(Roduro), made: "tend:agent"),
    (english: "Cook", group: Job, made: "cook:agent"),
    (english: "Meal runner", group: Job, made: "run:agent"),
    (english: "Merchant", group: Job, made: "trade:agent"),
    (english: "Caravaner", group: Job, made: "road:agent"),
    (english: "Innkeeper", group: Job, made: "guest+hold"),
    (english: "Guard", group: Job, made: "guard:agent"),
    (english: "Official", group: Job, made: "serve:agent"),
    (english: "Priest", group: Job, made: "priest"),
    (english: "Healer", group: Job, made: "heal:agent"),
    (english: "Teacher", group: Job, belongs: Some(Tadoro), made: "teacher"),
    (english: "Exchanger", group: Job, belongs: Some(Tadoro), made: "swap:agent"),
    (english: "Arbiter", group: Job, made: "judge:agent"),
    (english: "Labourer and porter", group: Job, made: "carry:agent", also: ["Hauler"]),
    (english: "Drifter", group: Job, belongs: Some(Tadoro), made: "migrate:agent"),
    (english: "Kelp gatherer", group: Job, belongs: Some(Horaro), made: "kelp:agent"),
    (english: "Boatwright", group: Job, belongs: Some(Horaro), made: "boat:agent"),
    (english: "Smith", group: Job, belongs: Some(Qotiro), made: "forge:agent"),
    (english: "Armourer", group: Job, belongs: Some(Qotiro), made: "shield:agent"),
    (english: "Alchemist", group: Job, belongs: Some(Tadoro), made: "brew:agent"),
    (english: "Scribe", group: Job, belongs: Some(Tadoro), made: "write:agent"),
    (english: "Weaver and sealer", group: Job, belongs: Some(Horaro), made: "weave:agent"),
    (english: "Tanner", group: Job, made: "tan:agent"),
    (english: "Leatherworker", group: Job, made: "hide:agent"),
    (english: "Tailor", group: Job, made: "cloth:agent"),
    (english: "Woodworker", group: Job, made: "carve:agent"),
    (english: "Charcoal burner", group: Job, made: "burn:agent"),
    (english: "Carpenter", group: Job, made: "timber:agent"),
    (english: "Mason", group: Job, belongs: Some(Qotiro), made: "stone+build:agent"),
    // At the squad's own base.
    (english: "Builder", group: Job, made: "build:agent"),
    (english: "Crafter", group: Job, made: "make:agent"),
    (english: "Idle", group: Job, made: "rest:agent"),

    // ==== Crafts (the making skills in src/sim/stats.rs, materials.rs) ===========
    (english: "Stone-tending", group: Craft, belongs: Some(Roduro), made: "stone+tend"),
    (english: "Smithing", group: Craft, belongs: Some(Qotiro), made: "forge+work"),
    (english: "Armoring", group: Craft, belongs: Some(Qotiro), made: "shield+work", also: ["Armouring"]),
    (english: "Masonry", group: Craft, belongs: Some(Qotiro), made: "stone+work"),
    (english: "Weaving", group: Craft, belongs: Some(Horaro), made: "weave+work", also: ["Weaving and sealing"]),
    (english: "Inscription", group: Craft, belongs: Some(Tadoro), made: "write+work", also: ["Paper, ink and scrolls"]),
    (english: "Alchemy", group: Craft, belongs: Some(Tadoro), made: "brew+work"),
    (english: "Handcraft", group: Craft, made: "hand+work", also: ["Leather, cloth and woodwork"]),
    (english: "Carpentry", group: Craft, made: "timber+work"),

    // ==== Materials and goods (materials.rs, the goods in jobs.rs, items.rs) =====
    // Grown stone: Roduro.
    (english: "Ringstone", group: Material, belongs: Some(Roduro), made: "ring+stone"),
    (english: "Hearthclay", group: Material, belongs: Some(Roduro), made: "hearth+clay"),
    (english: "Slatewing", group: Material, belongs: Some(Roduro), made: "rock+wing"),
    (english: "Edgeglass", group: Material, belongs: Some(Roduro), made: "sharp+glass"),
    (english: "Ringstone block", group: Material, belongs: Some(Roduro), made: "board/=Ringstone"),
    (english: "Slatewing sheet", group: Material, belongs: Some(Roduro), made: "paper/=Slatewing"),
    (english: "Edgeglass blank", group: Material, belongs: Some(Roduro), made: "board/=Edgeglass"),
    (english: "Edgeglass seed", group: Material, belongs: Some(Roduro), made: "seed/=Edgeglass", also: ["Edgeglass seed crystal"]),
    (english: "Rock feedstock", group: Material, belongs: Some(Roduro), made: "rock+food"),
    // Fire-made: Qotiro.
    (english: "Forgeiron", group: Material, belongs: Some(Qotiro), made: "forge+iron"),
    (english: "Bronze", group: Material, belongs: Some(Qotiro), made: "gold+iron"),
    (english: "Sandglass", group: Material, belongs: Some(Qotiro), made: "sand+glass"),
    (english: "Gold", group: Material, belongs: Some(Qotiro), made: "sun+ore"),
    (english: "Forgeiron ingots", group: Material, belongs: Some(Qotiro), made: "board/=Forgeiron"),
    (english: "Bronze ingot", group: Material, belongs: Some(Qotiro), made: "board/=Bronze"),
    // Sea and shore: Horaro.
    (english: "Seareed", group: Material, belongs: Some(Horaro), made: "sea+reed"),
    (english: "Nacre", group: Material, belongs: Some(Horaro), made: "bright+shell"),
    (english: "Fishskin", group: Material, belongs: Some(Horaro), made: "fish+hide"),
    (english: "Pearl", group: Material, belongs: Some(Horaro), made: "pearl", also: ["Pearls"]),
    (english: "Salvage", group: Material, belongs: Some(Horaro), made: "deep+find"),
    // Written and carried: Ṭaḍoro.
    (english: "Tentsilk", group: Material, belongs: Some(Tadoro), made: "tent+silk"),
    (english: "Scrollpaper", group: Material, belongs: Some(Tadoro), made: "write+paper"),
    // Shared basics.
    (english: "Plain iron", group: Material, made: "iron"),
    (english: "Iron ore", group: Material, made: "iron+ore"),
    (english: "Iron ingot", group: Material, made: "board/iron"),
    (english: "Ore", group: Material, made: "ore"),
    (english: "Timber", group: Material, made: "timber", also: ["Wood"]),
    (english: "Rock", group: Material, made: "rock"),
    (english: "Hide", group: Material, made: "hide", also: ["Hides"]),
    (english: "Leather", group: Material, made: "tan+hide"),
    (english: "Cloth", group: Material, made: "cloth"),
    (english: "Fibre", group: Material, made: "grass+silk"),
    (english: "Clay", group: Material, made: "clay"),
    (english: "Sand", group: Material, made: "sand"),
    (english: "Charcoal", group: Material, made: "black+timber"),
    (english: "Ash", group: Material, made: "ember"),
    (english: "Pitch", group: Material, made: "pitch"),
    (english: "Ink", group: Material, made: "black+water"),
    (english: "Reed paper", group: Material, made: "reed+paper"),
    (english: "Salt crystal", group: Material, made: "salt+crystal"),
    (english: "Wares", group: Material, made: "thing"),

    // ==== Weapons (items.rs) ====================================================
    // A made thing belongs to the people whose material it is usually made in
    // (the `usual` material of its form in items.rs): Forgeiron and Bronze are
    // Qotiro, Ringstone is Roduro, Nacre and Seareed are Horaro, Tentsilk is
    // Ṭaḍoro. Things usually made in plain iron, wood, leather or cloth are shared.
    (english: "Knife", group: Weapon, made: "knife"),
    (english: "Short sword", group: Weapon, belongs: Some(Qotiro), made: "knife:great", also: ["Short blade"]),
    (english: "Longsword", group: Weapon, belongs: Some(Qotiro), made: "long+knife", also: ["Sword"]),
    (english: "Club", group: Weapon, made: "strike+branch"),
    (english: "War-pick", group: Weapon, belongs: Some(Qotiro), made: "fight+horn"),
    (english: "Stone maul", group: Weapon, belongs: Some(Roduro), made: "strike+stone", also: ["Maul"]),
    (english: "Spear", group: Weapon, made: "spear"),
    (english: "Harpoon", group: Weapon, belongs: Some(Horaro), made: "fish+spear"),
    (english: "Glaive", group: Weapon, belongs: Some(Qotiro), made: "knife+staff"),
    (english: "Short bow", group: Weapon, made: "bow", also: ["Bow"]),
    (english: "Crossbow", group: Weapon, belongs: Some(Qotiro), made: "shut+bow"),
    (english: "Staff", group: Weapon, made: "staff"),
    (english: "Hatchet", group: Weapon, made: "branch+knife"),
    (english: "Trident", group: Weapon, belongs: Some(Horaro), made: "three+spear"),
    (english: "Sling", group: Weapon, made: "throw+rope"),
    (english: "Weighted net", group: Weapon, belongs: Some(Horaro), made: "heavy+net"),
    (english: "Arrows", group: Weapon, made: "bow+thorn"),
    (english: "Crossbow bolts", group: Weapon, belongs: Some(Qotiro), made: "iron+thorn"),
    (english: "Sling stones", group: Weapon, made: "throw+stone"),

    // ==== Armour and clothing (items.rs) ========================================
    // Built as "what it covers" + "what it is" (body-cloth, head-shield), with
    // no material in the word, so the same word serves whatever it is made of.
    (english: "Cloth shirt", group: Armour, made: "body+cloth", also: ["Shirt"]),
    (english: "Silk wraps", group: Armour, belongs: Some(Tadoro), made: "body+bind", also: ["Wraps"]),
    (english: "Padded jacket", group: Armour, made: "soft+shield"),
