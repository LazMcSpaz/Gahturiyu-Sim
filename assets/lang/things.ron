    (english: "Sandstone lamellar", group: Armour, belongs: Some(Qotiro), made: "body+shield", also: ["Plate cuirass"]),
    (english: "Leather cap", group: Armour, made: "head+shell", also: ["Cap"]),
    (english: "Iron helm", group: Armour, belongs: Some(Qotiro), made: "head+shield", also: ["Helm"]),
    (english: "Trousers", group: Armour, made: "foot+cloth"),
    (english: "Hide leggings", group: Armour, made: "foot+hide", also: ["Leggings"]),
    (english: "Scale greaves", group: Armour, belongs: Some(Qotiro), made: "foot+scale", also: ["Greaves"]),
