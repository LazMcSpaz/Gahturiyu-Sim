// A small Last Wave outpost, from Laz's drawing (now his mark `last_wave_outpost`, d36; his
// place file `assets/world/places/last_wave_outpost.json` overrides this plan in the game,
// so this stays as the sketch's transcription) (docs/plans/last_wave_outpost_southwest.png,
// 14 Oct 2026), read a second time with the buildings' corners measured on a gridded copy of the
// drawing (scratch script plan_read.py: corners -> centre, long axis, size; the door on the short
// end that looks toward the middle; the trees rastered from the ink). Scale: a "room for 12"
// house drawn 260 px long is 15 m, so 0.0577 m a pixel. The centre (the hearth) is the open
// ground east of the chieftain's quarters, pixel (1650, 1250); nothing was drawn there.
// Places are metres east and south of the centre; facings are degrees, 0 east, 90 south, 180 west,
// 270 north: the way the door looks, with the building's long side running that way. Sizes are
// metres along the long side.
//
// Variants are the nearest the game has today; `wants` says what the drawing asks for that the
// variant doesn't give yet, so the right shape can be made without going back to the picture.
(
    town: "last_wave_outpost",
    title: "Small Last Wave outpost",
    notes: "Southwest of Open Hand capital city. Housing: 2 tiered, timber, room for 12, workshop below. Temple / priestess quarters: 3 tiered, stone, room for 12, entry not permitted to outsiders. Chieftain's quarters: 2 tiered, stone, room for 12; second in command to the priestesses lives here. Forge: large open courtyard, stone. Incense house: timber hall, antechamber to get in. Tanner: outdoor. Storage: non-food, timber. Timber storage. Gardens. Animal pens. Woods all round and between.",
    sketch: "docs/plans/last_wave_outpost_southwest.png",
    scale: 0.0577,
    origin: (1650, 1250),
    buildings: [
        // Top left.
        (label: "Shield maker's house", kind: QotiroBlock, variant: Some("qotiro_workyard"), at: (-75.6, -56.0), facing: 334.0, size: 15.7, room_for: 12,
         wants: "2 tiers, timber, the shield maker's workshop below and the living above"),
        (label: "Fletcher and bowyer's house", kind: QotiroBlock, variant: Some("qotiro_benchyard"), at: (-57.5, -41.5), facing: 316.0, size: 16.9, room_for: 12,
         wants: "2 tiers, timber, the bowyer's bench below and the living above"),
        // The middle.
        (label: "Temple and priestess quarters", kind: QotiroTemple, variant: Some("qotiro_temple"), at: (-26.9, -22.3), facing: 63.0, size: 12.9, room_for: 12,
         wants: "3 tiers, stone, quarters for 12 priestesses; entry not permitted to outsiders (a rule, not a shape); drawn taller than wide"),
        (label: "Forge", kind: QotiroBlock, variant: Some("qotiro_workyard"), at: (-9.4, -21.4), facing: 357.0, size: 10.4, room_for: 0,
         wants: "stone, a large open courtyard with the forge in it"),
        (label: "Chieftain's quarters", kind: QotiroBlock, variant: Some("qotiro_court"), at: (-23.0, -1.6), facing: 37.0, size: 9.7, room_for: 12,
         wants: "2 tiers, stone; the chieftain and the priestesses' second in command live here"),
        // West.
        (label: "Incense house", kind: QotiroHall, variant: Some("qotiro_island_hall"), at: (-67.6, -1.5), facing: 11.0, size: 11.0, room_for: 0,
         wants: "a timber hall, long and low, with an antechamber you must pass through to get in"),
        // Bottom left.
        (label: "Herbalist and alchemist's house", kind: QotiroBlock, variant: None, at: (-73.3, 14.8), facing: 67.0, size: 12.8, room_for: 12,
         wants: "2 tiers, timber, the stillroom below and the living above; garden plots beside it to the west"),
        // Bottom right.
        (label: "Leather crafter's house", kind: QotiroBlock, variant: Some("qotiro_benchyard"), at: (-1.7, 27.5), facing: 337.0, size: 15.6, room_for: 12,
         wants: "2 tiers, timber, the leatherworker's bench below and the living above"),
        (label: "Smoker's house", kind: QotiroBlock, variant: None, at: (25.1, 28.6), facing: 151.0, size: 14.5, room_for: 12,
         wants: "2 tiers, timber, a smokehouse below (a chimney smoking) and the living above"),
    ],
    places: [
        // Work done in a building stands on that building: it's reached by its door.
        (label: "The temple's shrine", kind: Shrine, at: (-26.9, -22.3)),
        (label: "The chieftain's hall", kind: Hall, at: (-23.0, -1.6)),
        (label: "The forge", kind: Forge, at: (-9.4, -21.4)),
        (label: "The shield maker's bench", kind: Bench, at: (-75.6, -56.0)),
        (label: "The bowyer's workshop", kind: Workshop, at: (-57.5, -41.5)),
        (label: "The leather crafter's workshop", kind: Workshop, at: (-1.7, 27.5)),
        (label: "The herbalist's table", kind: AlchemyTable, at: (-73.3, 14.8)),
        (label: "The smoker's kitchen", kind: Kitchen, at: (25.1, 28.6)),
        // Outdoors.
        (label: "The tanner's pits", kind: Workshop, at: (15.6, 37.5), wants: "open-air vats and stretching frames"),
        (label: "The storage sheds", kind: Shop(Materials), at: (-53.9, 9.1), wants: "two small timber sheds, non-food storage"),
    ],
